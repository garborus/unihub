{
  "name": "unihub",
  "version": "0.1.8",
  "description": "Um só app para configurar periféricos de vários fabricantes: controles, headsets e teclados, de qualquer marca.",
  "author": "unushub-team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/garborus/UnusHub.git"
  },
  "type": "module",
  "main": "src/main/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder --win nsis --publish never",
    "dist:portatil": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "io.github.garborus.unihub",
    "productName": "UnusHub",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/audio-mix",
        "to": "native/audio-mix",
        "filter": [
          "build/*.dll",
          "build/*.exe",
          "versao.txt"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "UnusHub",
      "uninstallDisplayName": "UnusHub",
      "artifactName": "UnusHub-Setup-${version}.exe",
      "include": "build/installer.nsh",
      "installerLanguages": [
        "pt_BR",
        "en_US",
        "es_ES"
      ],
      "displayLanguageSelector": false
    },
    "portable": {
      "artifactName": "UnusHub-${version}-portable.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "garborus",
      "repo": "UnusHub",
      "releaseType": "prerelease"
    }
  },
  "dependencies": {
    "electron-updater": "6.6.2"
  }
}
